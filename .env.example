CLOUDFLARE_TUNNEL_TOKEN=
TAILNET_IP=100.64.0.1
PUBLIC_URL=https://boostcontent.io
DB_PASSWORD=
AUTHENTICATOR_PASSWORD=
AUTH_DB_PASSWORD=
ADMIN_AUTHENTICATOR_PASSWORD=
JWT_SECRET=
ADMIN_JWT_SECRET=
INFERENCE_URL=
INFERENCE_KEY=
S3_PUBLIC_ENDPOINT=
S3_INTERNAL_ENDPOINT=
S3_BUCKET=bc-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
REPL_PASSWORD=                  # random; followers stream with it and nodes ask each other's role with it
NODES=                          # every node in priority order, "tailnetIP[/lanIP] tailnetIP[/lanIP] …" (same on all nodes)
# NODE_FAIL_SECS=60              # how long the nodes above this one must be unreachable before it takes over
# INFERENCE_PUBLIC_HOST=        # optional: a public name for the inference gateway, served at /v1 through this entry
# INFERENCE_UPSTREAMS=          # every node's gateway, THIS node's first (default: INFERENCE_URL), e.g. "http://100.64.0.1:8000 http://100.64.0.12:8000"
ALERT_URL=                      # empty = off. Gets {"text": "..."} on takeover, a node down, the site down, a missed backup
OFFSITE_REMOTE=                 # empty = off. An rclone remote for the encrypted dumps + pictures, e.g. :s3,provider=Cloudflare,access_key_id=…,secret_access_key=…,endpoint=https://<account>.r2.cloudflarestorage.com:<bucket>/boostcontent
OFFSITE_PASSPHRASE=             # encrypts the off-site copy. Keep a copy of it OUTSIDE the Sparks
