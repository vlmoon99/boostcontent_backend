# The only HTTP entry points. :3100 is what the Cloudflare tunnel already sends boostcontent.io to;
# :3200 is the owner console, published on the tailnet IP only (compose ports).
{
	admin off
	auto_https off
}

:3100 {
	# The inference gateway's public name rides the same tunnel and the same `localhost:3100`, whichever node
	# is the master. Only the model API (/v1) is public: the gateway's key management is not. Upstreams are
	# tried in order (this node's own gateway first), health-checked every 5 s.
	@inference host {$INFERENCE_PUBLIC_HOST:inference.invalid}
	handle @inference {
		handle /v1/* {
			reverse_proxy {$INFERENCE_UPSTREAMS} {
				lb_policy first
				lb_try_duration 8s
				health_uri /health/liveliness
				health_interval 5s
				health_timeout 3s
				fail_duration 6s
				request_buffers 32MB      # so a request can be sent again to the next gateway
				transport http {
					dial_timeout 2s
				}
			}
		}
		handle {
			respond "not found" 404
		}
	}
	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}
	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}
	# S3 path-style; the Host header passes through untouched, so pre-signed URLs verify in Garage
	handle /bc-media/* {
		reverse_proxy garage:3900
	}
	handle {
		respond "BoostContent" 200
	}
}

:3200 {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy rest-admin:3000
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
