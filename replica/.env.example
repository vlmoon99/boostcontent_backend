PRIMARY_HOST=100.64.0.1          # the primary's tailnet IP (compose publishes db on :5442 there)
PRIMARY_PORT=5442
REPL_PASSWORD=                   # the primary's REPL_PASSWORD
S3_ENDPOINT=http://100.64.0.1:3900
S3_BUCKET=bc-media
S3_ACCESS_KEY=                   # a READ-ONLY Garage key: garage key create bc-replica; garage bucket allow --read bc-media --key bc-replica
S3_SECRET_KEY=
# BACKUP_DIR=./.data             # dumps/ and media/ land here
# MEDIA_EVERY=3600               # seconds between media syncs
